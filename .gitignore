# Ignore editor specific config folders/files
/.vscode

# Ignore compilation result directories
/build
/output
/docs/api
/_site

# Ignore generated files in the libdragon FS
/filesystem/Firple-Bold.font64
/filesystem/FiraMonoBold.font64
/filesystem/*.wav64
/filesystem/*.sprite

# Ignore external development tools (but keep our SFX generator)
/tools/*
!/tools/gen_sfx.py

# Ignore n64 tools
/.n64inst

# libdragon is a real submodule (pinned to 5cb976aa) -- do NOT ignore it, that is exactly what
# prevented git from ever recording its gitlink and made fresh clones unbuildable.

# Ignore cover art assets
/boxart
/assets/images/boxart

# Ignore any N64 ROM
**/*.n64
**/*.v64
**/*.z64

# Ignore exe files
*.exe

# Ignore macOS filesystem cruft
.DS_Store

# --- N64ever: exclude build output + host tools (the box-art library IS tracked) ---
/filesystem/
/.hosttools/
